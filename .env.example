HOST=127.0.0.1
PORT=4300
DEMO_MODE=true
# Live mode requires all three settings below and DEMO_MODE=false.
ADMIN_USERNAME=
ADMIN_PASSWORD=
DEVICE_INGEST_TOKEN=
# Optional absolute path; demo and live use separate SQLite files by default.
DATA_DIR=
# Production HTTPS reverse proxy only:
SECURE_COOKIES=false
# Comma-separated exact Web origins when serving the frontend separately:
WEB_ORIGINS=
